{
  "name": "uxprobe",
  "version": "0.1.0",
  "description": "Find UX-level bugs in vibe-coded web apps with deterministic browser checks",
  "type": "module",
  "bin": {
    "uxprobe": "bin/uxprobe"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "minefield": "node test/minefield/server.mjs",
    "score": "node test/score.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "4.10.2",
    "playwright": "1.60.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Spider615/uxprobe.git"
  }
}
